# Porta HTTP do backend
PORT=8000

# Salt das hashes HMAC (CPF, IP, user-agent, tokens). Gere um valor aleatório
# em produção: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_KEY=

# Caminho do banco SQLite (":memory:" nos testes)
DB_PATH=./database/portal.sqlite

# Origens autorizadas (CORS), separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
