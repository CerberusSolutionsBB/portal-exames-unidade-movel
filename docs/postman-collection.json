{
  "info": {
    "name": "Portal Exames - Unidade Móvel 121",
    "description": "Endpoints de autenticação do portal de acesso a exames (Laravel 12 + Sanctum).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Acessar exame (login)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"123.456.789-09\",\n  \"nascimento\": \"15/03/1990\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/acesso",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "acesso"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('access_token', pm.response.json().token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Exames",
      "item": [
        {
          "name": "Status do exame (protegido)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8000/api/exames/status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "exames", "status"]
            }
          }
        },
        {
          "name": "Logout (protegido)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8000/api/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "logout"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ]
}
